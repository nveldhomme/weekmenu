  "meals": [
    {
      "day": "Maandag",
      "title": "Groene spinaziecurry met paksoi en rijst",
      "time": "30 min",
      "shared": "Spinazie (Poiesz) en baby paksoi in kokosmelk met groene currypasta, knoflook en gember; jasmijnrijst.",
      "him": "Kipfilet 400 g van de Qualiko-zak (Poiesz) in blokjes, mee gestoofd in zijn deel van de curry",
      "her": "Vega kipstukjes van De Vegetarische Slager (Poiesz), apart goudbruin gebakken",
      "steps": [
        "Zet 250 g jasmijnrijst op.",
        "Bak de kipblokjes in een pan 6 minuten; bak in een tweede pan de vega stukjes knapperig.",
        "Fruit knoflook, gember en 2 el groene currypasta in de wok, giet er 400 ml kokosmelk bij.",
        "Laat de gehalveerde baby paksoi 3 minuten meekoken en roer de spinazie erdoor tot hij slinkt.",
        "Schep de curry over twee pannen of borden: kip bij hem, vega stukjes bij haar; serveer met rijst."
      ]
    },
    {
      "day": "Dinsdag",
      "title": "Roerbak met karbonadereepjes en paksoi",
      "time": "25 min",
      "shared": "Wokgroenten (Poiesz, 2 voor €3,50) met paksoi, knoflook en ketjap; zilvervliesrijst.",
      "him": "Schouderkarbonade 500 g (Poiesz) in reepjes, krokant gebakken met een scheut sojasaus",
      "her": "Omelet van 3 eieren met bosui, in reepjes gesneden",
      "steps": [
        "Zet 250 g rijst op.",
        "Snijd de karbonade in reepjes en bak ze in een hete pan 6-8 minuten.",
        "Klop 3 eieren met bosui en bak er een dunne omelet van; rol op en snijd in reepjes.",
        "Roerbak in de wok knoflook, 1 zak wokgroenten en de paksoi 4 minuten en blus af met 2 el ketjap.",
        "Verdeel rijst en groenten; karbonade bij hem, omeletreepjes bij haar."
      ]
    },
    {
      "day": "Woensdag",
      "title": "Zoetzure wok met Chinese kool",
      "time": "25 min",
      "shared": "Jumbo wokgroenten Oosters (1+1 gratis) met Chinese kool en Easy Chicken Tonight zoetzuur of een Easy Asia Tonight-saus (Jumbo, 1+1 gratis); pandanrijst.",
      "him": "De overige 600 g kipfilet van de Qualiko-zak (Poiesz) in reepjes",
      "her": "Tofu 375 g, in blokjes knapperig gebakken",
      "steps": [
        "Zet 250 g pandanrijst op en dep de tofu droog.",
        "Bak de tofublokjes in een pan rondom goudbruin; bak in een tweede pan de kipreepjes gaar.",
        "Roerbak 1 zak wokgroenten en een halve Chinese kool in reepjes 4 minuten in de wok.",
        "Schenk 1 pot zoetzure saus erbij en verwarm 2 minuten.",
        "Verdeel; kip bij hem en tofu bij haar door de saus scheppen."
      ]
    },
    {
      "day": "Donderdag",
      "title": "Nasi met shoarma of gebakken ei",
      "time": "25 min",
      "shared": "Nasi van gekookte rijst met de tweede zak Jumbo wokgroenten, de rest van de Chinese kool en Jumbo nasi topping (1+1 gratis).",
      "him": "Flinterdun shoarmavlees 400 g (Poiesz), krokant gebakken",
      "her": "Twee spiegeleieren met sambal en bosui",
      "steps": [
        "Kook 250 g rijst, of gebruik rijst van dinsdag die koud bewaard is.",
        "Bak het shoarmavlees in een aparte pan 5 minuten krokant.",
        "Roerbak de wokgroenten en de Chinese kool 3 minuten, voeg 1 bakje nasi topping en de rijst toe en bak 4 minuten door.",
        "Bak voor haar 2 spiegeleieren.",
        "Verdeel de nasi met shoarma voor hem en eieren met bosui voor haar."
      ]
    },
    {
      "day": "Vrijdag",
      "title": "Teriyaki met broccoli, courgette en biefstuk",
      "time": "25 min",
      "shared": "Broccoliroosjes (Poiesz) en courgette (Jumbo) uit de wok met teriyakisaus, sesam en bosui; jasmijnrijst.",
      "him": "Biefstuk (Aldi), kort gebakken en in plakken gesneden",
      "her": "Tweede pak De Vegetarische Slager (Poiesz), gebakken en door de teriyakisaus gehaald",
      "steps": [
        "Zet 250 g rijst op en haal de biefstuk op kamertemperatuur.",
        "Roerbak broccoliroosjes en courgette in halve maantjes 5 minuten in de wok.",
        "Bak de biefstuk 2-3 minuten per kant, laat rusten; bak de vega stukjes in een tweede pan.",
        "Schenk 4 el teriyakisaus over de groenten en schep om.",
        "Verdeel; snijd de biefstuk in plakken voor hem, vega bij haar, bestrooi met sesam en bosui."
      ]
    }
  ],
