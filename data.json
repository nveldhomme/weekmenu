  "meals": [
    {
      "day": "Maandag",
      "title": "Kip-roerbak met paksoi en jasmijnrijst",
      "time": "25 min",
      "shared": "Roerbakgroenten (Nettorama) en paksoi met bosui (Poiesz) uit de wok met knoflook, gember, sojasaus en ketjap. Jasmijnrijst.",
      "him": "Halve bak kipfilet (Nettorama) in reepjes, apart aangebraden; rest bewaren voor donderdag",
      "her": "Twee gebakken scharreleieren (Poiesz) met een scheut sojasaus",
      "steps": [
        "Zet 250 g jasmijnrijst op.",
        "Snijd de helft van de kipfilet in reepjes en bak in een aparte pan 6 tot 8 minuten gaar.",
        "Fruit knoflook en gember in de wok, bak de roerbakgroenten 3 minuten, voeg de paksoi in parten toe.",
        "Blus af met 3 el sojasaus en 1 el ketjap; bak voor haar 2 eieren.",
        "Verdeel rijst en groenten, kip op zijn bord, eieren op het hare, bestrooi met bosui."
      ]
    },
    {
      "day": "Dinsdag",
      "title": "Koreaanse gochujang-bowl met broccoli en spinazie",
      "time": "30 min",
      "shared": "Rijst met geroosterde broccoli (Poiesz), geslonken spinazie (Poiesz) en een saus van Sempio gochujang (Poiesz), sojasaus en honing.",
      "him": "Speklappen (Nettorama) in reepjes krokant gebakken en geglaceerd met gochujang",
      "her": "Vivera vleesvervanger (Poiesz) krokant gebakken met dezelfde saus, plus een gebakken ei (Poiesz)",
      "steps": [
        "Zet 250 g rijst op. Meng 2 el gochujang, 2 el sojasaus en 1 el honing.",
        "Snijd de broccoli in roosjes en bak 6 minuten in de wok met wat olie.",
        "Bak in twee pannen de speklappen-reepjes en de Vivera krokant; glaceer elk met de helft van de saus.",
        "Laat de spinazie op het laatst slinken bij de broccoli; bak een ei voor haar.",
        "Schep rijst, groenten en eiwit in kommen en bestrooi met bosui."
      ]
    },
    {
      "day": "Woensdag",
      "title": "Ramen met flanksteak, paksoi en zachtgekookt ei",
      "time": "30 min",
      "shared": "Bouillon van groentebouillon, sojasaus, gember en knoflook met Go-Tan ramen noodles (Poiesz), paksoi (Poiesz) en een zak roerbakgroenten (Nettorama).",
      "him": "Runderflanksteak (Aldi) kort gebakken en in dunne plakjes",
      "her": "Twee zachtgekookte scharreleieren (Poiesz), gehalveerd",
      "steps": [
        "Haal de flanksteak op tijd uit de koelkast en kook 2 eieren in 6,5 minuut; laat schrikken.",
        "Breng 1,2 liter bouillon met 3 el sojasaus, gember en knoflook aan de kook.",
        "Bak de flanksteak 3 minuten per kant op hoog vuur, laat rusten en snijd dun tegen de draad in.",
        "Kook de noodles en roerbakgroenten 3 minuten mee in de bouillon, de paksoi de laatste minuut.",
        "Verdeel over kommen: steak op zijn kom, eieren op de hare, bosui erover."
      ]
    },
    {
      "day": "Donderdag",
      "title": "Pompoencurry met spinazie en rijst",
      "time": "35 min",
      "shared": "Romige curry van hokkaidopompoen (Nettorama), prei (Lidl) en spinazie (Poiesz) met kerriepasta en kokosmelk. Rijst.",
      "him": "Rest van de kipfilet (Nettorama) in blokjes, apart aangebraden en door zijn portie geroerd",
      "her": "Kikkererwten door haar portie, met een flinke lepel Griekse yoghurt (Lidl)",
      "steps": [
        "Zet 250 g rijst op. Snijd een halve pompoen in blokjes (schil mag eraan) en de prei in ringen.",
        "Fruit prei en 2 el kerriepasta, voeg pompoen en een blik kokosmelk toe; 15 minuten zacht koken.",
        "Bak intussen de kipblokjes gaar in een aparte pan.",
        "Verdeel de curry over twee pannetjes en roer de spinazie erdoor; kip bij hem, kikkererwten bij haar.",
        "Serveer met rijst; Griekse yoghurt erop voor haar."
      ]
    },
    {
      "day": "Vrijdag",
      "title": "Gyros-rijstbowl met snijbonen en tzatziki",
      "time": "30 min",
      "shared": "Rijst met knoflook-snijbonen (Nettorama), mini-komkommer (Nettorama) en tzatziki van Griekse yoghurt (Lidl). Heks'nkaas (Jumbo) erbij.",
      "him": "Gyrosvlees met paprika (Nettorama) knapperig gebakken",
      "her": "Vivera vleesvervanger (Poiesz) met gyroskruiden gebakken, of 2 eieren als die op zijn",
      "steps": [
        "Zet 250 g rijst op. Snijd de snijbonen schuin en kook ze 6 minuten.",
        "Rasp een mini-komkommer en meng met Griekse yoghurt, knoflook en zout tot tzatziki.",
        "Bak in twee pannen het gyrosvlees en de Vivera met gyroskruiden.",
        "Schep de snijbonen om met knoflook en olijfolie; snijd de rest van de komkommers in plakjes.",
        "Bouw de bowls op met rijst, groenten, eiwit, tzatziki en Heks'nkaas."
      ]
    }
  ],
