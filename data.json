  "meals": [
    {
      "day": "Maandag",
      "title": "Bami-wok met kipdijshoarma en pandanrijst",
      "time": "25 min",
      "shared": "Bami-nasigroenten en spitskool (Poiesz) uit de wok met knoflook, gember (Poiesz) en ketjap; pandanrijst (Nettorama).",
      "him": "Kipdijshoarma 400 g (Poiesz), krokant gebakken in een aparte pan",
      "her": "Twee gebakken eieren met sojasaus en lente-ui",
      "steps": [
        "Zet 250 g pandanrijst op.",
        "Bak de kipdijshoarma in een aparte pan 8 minuten bruin en gaar.",
        "Fruit knoflook en geraspte gember in de wok, roerbak de bami-nasigroenten en de spitskool 4 minuten.",
        "Blus af met 2 el ketjap en 1 el sojasaus; bak intussen voor haar 2 eieren.",
        "Verdeel rijst en groenten, shoarma op zijn bord, eieren op het hare."
      ]
    },
    {
      "day": "Dinsdag",
      "title": "Roerbak met varkenshaas, spinazie en rijst",
      "time": "25 min",
      "shared": "Roerbakgroenten (Nettorama) met spinazie en lente-ui (Lidl), saus van soja, honing en sesamolie; pandanrijst (Nettorama).",
      "him": "Varkenshaas (Aldi) in dunne reepjes, kort en heet gebakken",
      "her": "Tofu in blokjes (Overal), knapperig gebakken met maïzena",
      "steps": [
        "Zet 250 g rijst op.",
        "Snijd de varkenshaas in reepjes; dep de tofu droog, snijd in blokjes en wentel door 1 el maïzena.",
        "Bak de tofu in een pan goudbruin, daarna in dezelfde pan de varkenshaas 3 minuten.",
        "Roerbak de roerbakgroenten 3 minuten in de wok, schep de spinazie erdoor tot hij slinkt.",
        "Roer 3 el sojasaus, 1 tl honing en een scheut sesamolie erdoor; serveer met lente-ui."
      ]
    },
    {
      "day": "Woensdag",
      "title": "Koreaanse rijstbowl met gehakt en sperziebonen",
      "time": "30 min",
      "shared": "Sperziebonen (Poiesz) en waspeen (Poiesz) met knoflook en sesam; rijst; saus van sojasaus, honing en sambal.",
      "him": "Rundergehakt 300 g (Jumbo, 1+1) rul gebakken met gember en sojasaus; tweede pak invriezen",
      "her": "Beyond Burger (Jumbo, 1+1) verkruimeld en op dezelfde manier gebakken, plus een gebakken ei",
      "steps": [
        "Zet 250 g rijst op en snijd de waspeen in dunne reepjes.",
        "Bak het gehakt rul in een pan met gember en 2 el sojasaus; doe hetzelfde in een tweede pan met 2 verkruimelde Beyond Burgers.",
        "Roerbak sperziebonen en waspeen 5 minuten met knoflook in de wok.",
        "Meng 2 el sojasaus, 1 tl honing en 1 tl sambal tot saus; bak voor haar een ei.",
        "Schep alles op de rijst, bestrooi met sesamzaad en lente-ui."
      ]
    },
    {
      "day": "Donderdag",
      "title": "Gebakken rijst met paksoi, champignons en biefstukpuntjes",
      "time": "25 min",
      "shared": "Gebakken rijst (rijst van woensdag extra koken) met paksoi (Overal), champignons (Poiesz) en lente-ui (Lidl).",
      "him": "Gemarineerde biefstukpuntjes (Lidl) kort gebakken",
      "her": "Roerei van 3 eieren door haar portie rijst",
      "steps": [
        "Gebruik 500 g gekookte rijst van gisteren (of kook rijst en laat afkoelen).",
        "Bak de biefstukpuntjes in een hete pan 3 minuten en houd warm.",
        "Bak de champignons in de wok bruin, voeg de paksoi in parten toe en bak 2 minuten.",
        "Schep de rijst erdoor met 3 el sojasaus; schuif haar portie opzij en roer er 3 losgeklopte eieren door.",
        "Serveer met lente-ui; vlees op zijn bord."
      ]
    },
    {
      "day": "Vrijdag",
      "title": "Gele curry met paprika, courgette en rijst",
      "time": "40 min",
      "shared": "Curry van paprika mix (Poiesz), courgette (Aldi) en spinazie met kokosmelk en gele currypasta; basmatirijst (Nettorama).",
      "him": "Kipdrumsticks 500 g (Poiesz) uit de oven, met currypasta ingewreven",
      "her": "Kikkererwten (Overal) in haar deel van de curry, met een lepel proteïne yoghurt (Lidl)",
      "steps": [
        "Wrijf de drumsticks in met 1 el currypasta en rooster 35 minuten op 200 °C.",
        "Zet 250 g rijst op.",
        "Fruit ui en de rest van de currypasta, bak paprika en courgette 5 minuten.",
        "Giet de kokosmelk erbij, laat 10 minuten pruttelen en roer de spinazie erdoor; doe de kikkererwten in een apart pannetje met een deel van de curry.",
        "Serveer met rijst; drumsticks voor hem, yoghurt op haar curry."
      ]
    }
  ],
